// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  rol           String   // Ej: "Gerente", "Almacen", etc.
  nombre        String
}

model Proveedor {
  id           Int      @id @default(autoincrement())
  nit_rut      String   @unique
  razon_social String   @unique
  telefono     String?
  estado       String   @default("Activo") // "Activo" o "Inactivo" para borrado lógico
}
